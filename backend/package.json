{
  "name": "@housify/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "node ../scripts/ensure-port.cjs 4000 backend",
    "dev": "cross-env NODE_OPTIONS=\"--require ./scripts/dns-fix.cjs\" tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "prestart": "node ../scripts/ensure-port.cjs 4000 backend",
    "start": "cross-env NODE_OPTIONS=\"--require ./scripts/dns-fix.cjs\" node dist/server.js",
    "typecheck": "tsc --noEmit",
    "seed:admin": "cross-env NODE_OPTIONS=\"--require ./scripts/dns-fix.cjs\" tsx src/scripts/seed-admin.ts",
    "test:e2e": "cross-env NODE_OPTIONS=\"--require ./scripts/dns-fix.cjs\" tsx src/scripts/e2e-smoke.ts",
    "cleanup:uploads": "cross-env NODE_OPTIONS=\"--require ./scripts/dns-fix.cjs\" tsx src/scripts/cleanup-uploads.ts",
    "check:storage": "cross-env NODE_OPTIONS=\"--require ./scripts/dns-fix.cjs\" tsx src/scripts/check-storage.ts"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.2",
    "@fastify/multipart": "^9.4.0",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/static": "^8.3.0",
    "@housify/types": "*",
    "bcrypt": "^5.1.1",
    "cloudinary": "^2.11.0",
    "dotenv": "^16.4.7",
    "fastify": "^5.2.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.9.2",
    "sharp": "^0.34.5",
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^20.17.10",
    "cross-env": "^7.0.3",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
