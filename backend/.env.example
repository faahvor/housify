PORT=4000
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/prestige-homes?retryWrites=true&w=majority
JWT_SECRET=change-me-to-a-long-random-string
WEB_ORIGIN=http://localhost:3001

# Used only by `npm run seed:admin` to create/update the admin account
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_NAME=

# Uploaded media (local storage driver). PUBLIC_API_URL builds the links to them.
PUBLIC_API_URL=http://localhost:4000
UPLOAD_DIR=
